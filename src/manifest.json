{
  "manifest_version": 3,
  "name": "GitLab Rendered Markdown Review",
  "version": "0.0.0",
  "description": "Review and comment on Markdown files in GitLab merge requests as rendered documents.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gitlab-rendered-md@jmnser.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://gitlab.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://gitlab.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
